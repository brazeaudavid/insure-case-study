flowchart LR
    subgraph define["Defined once"]
        A["Rater build (CI)<br/>inputs declared in code<br/>manifest generated<br/>checked against live programs"]
        B["Question definitions<br/>generated from the manifest per rater version<br/>immutable once referenced"]
    end
    subgraph configure["Configured"]
        C["Program publish<br/>pinned rater has what the program uses<br/>every required input covered<br/>by a required question or a preset<br/>overrides within limits, modules exist"]
    end
    subgraph collect["Collected"]
        D["Answer write<br/>known key, right type,<br/>allowed value"]
        E["Submit<br/>all required visible<br/>questions answered"]
    end
    subgraph rate["Rated"]
        F["Preflight<br/>payload valid against<br/>the manifest"]
        G["Rater<br/>validates input,<br/>structured errors,<br/>no silent defaults"]
    end
    A --> B --> C --> D --> E --> F --> G
    A -. "undeclared input: tests fail" .-> X1[["blocked"]]
    C -. "cannot publish" .-> X2[["blocked"]]
    D -. "422 with field errors" .-> X3[["rejected"]]
    E -. "422 with requirements" .-> X3
    F -. "needs_attention + alarm,<br/>no premium written" .-> X4[["stopped"]]
    G -. "error recorded in rating_run" .-> X4
